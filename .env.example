# Copy to .env and fill in ONE provider
LLM_PROVIDER=gemini              # gemini | openai
LLM_MODEL=gemini-2.0-flash       # e.g. gpt-4o-mini for openai
GOOGLE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=models/text-embedding-004   # text-embedding-3-small for openai

LLM_TEMPERATURE=0
RETRIEVAL_TOP_K=20
MAX_VERIFIER_RETRIES=2
MAX_CLARIFICATION_ROUNDS=1
LOG_LEVEL=INFO
